# Gemma & Ollama OCR Configuration for MediSave
# Local development default:
OLLAMA_API_BASE=http://localhost:11434

# Optional: Remote/deployed endpoint and API key
# If deploying on Vercel/Netlify/Cloud with a secured remote Ollama server:
# OLLAMA_API_BASE=https://your-ollama-deployment.com
# OLLAMA_API_KEY=your_api_key_here

# Gemma Model name (e.g., gemma, paligemma)
OLLAMA_MODEL=gemma

# Supabase Authentication & Database Configuration
# Obtain from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

